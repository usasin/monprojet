rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function teamRole(appId, orgId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId)/members/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId)/members/$(request.auth.uid)).data.role
        : null;
    }

    function activeTeamMember(appId, orgId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId))
        && firestore.get(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId)).data.status == 'active'
        && (!('subscriptionUntil' in firestore.get(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId)).data)
          || firestore.get(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId)).data.subscriptionUntil == null
          || (firestore.get(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId)).data.subscriptionUntil is timestamp
            && firestore.get(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId)).data.subscriptionUntil > request.time))
        && firestore.exists(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/apps/$(appId)/orgs/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
    }


    // Médias éditoriaux publiés par l'administrateur Firebase.
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Pièces privées : 10 Mo maximum, images/PDF/audio uniquement.
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|application/pdf|audio/.*'
        );
    }

    // Logo d'entreprise. Tous les membres actifs peuvent le lire ; seul
    // l'administrateur principal peut le modifier.
    match /apps/{appId}/orgs/{orgId}/branding/{fileName} {
      allow read: if activeTeamMember(appId, orgId);
      allow create, update: if activeTeamMember(appId, orgId)
        && teamRole(appId, orgId) == 'OWNER'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if activeTeamMember(appId, orgId)
        && teamRole(appId, orgId) == 'OWNER';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
